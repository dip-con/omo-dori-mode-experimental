# Optional environment overrides. Nothing here is required: config.json covers the per-machine values.
# The LaunchAgents that install.sh writes already set HOME and OMOCAT_HOME.
# Secrets are files, not env vars (see docs/PORTING.md section 2).

# Runtime + data folder (code, config.json, queue db, logs/, state/). Default ~/.omocat
OMOCAT_HOME=
# Config file other than $OMOCAT_HOME/config.json
DORI_PORTABLE_CONFIG=

# KakaoTalk
KKA_ARCHIVE_ROOT=
KAKAO_LIVE_LOG=
DANDORI_KAKAO_LOGS=
ACME_LEDGER=
WAKE_FILTER_LOG=
AGENT_MESSENGER_CONFIG_DIR=

# omo / herdr
OMO_SESSIONS_DIR=
DORI_LANES_DIR=

# heartbeat: 1 lets it restart dead lanes (kakao lanes need HEARTBEAT_RESTART_KAKAO=1 too)
HEARTBEAT_LANE_RESTART=0
HEARTBEAT_RESTART_KAKAO=0

# voice replies (oc.ts say) port
OMOCAT_VOICE_PORT=47820
