# Optional environment overrides. Nothing here is required: config.json covers the per-machine values.
# The LaunchAgents that install.sh writes already set HOME and OMODORI_HOME.
# Secrets are files, not env vars (see docs/PORTING.md section 2).

# Runtime + data folder (code, config.json, queue db, logs/, state/). Default ~/.omodori
OMODORI_HOME=
# Config file other than $OMODORI_HOME/config.json
DORI_PORTABLE_CONFIG=

# Messenger sources: see sources/<name>/.env.example
AGENT_MESSENGER_CONFIG_DIR=

# omo / herdr
OMO_SESSIONS_DIR=
DORI_LANES_DIR=

# heartbeat: 1 lets it restart dead lanes (a source's standing lanes need HEARTBEAT_RESTART_SOURCE_LANES=1 too)
HEARTBEAT_LANE_RESTART=0
HEARTBEAT_RESTART_SOURCE_LANES=0

# voice replies (oc.ts say) port
OMODORI_VOICE_PORT=47820
