{
  "//": "LaunchAgents install.sh renders with render.ts. {bun} = the bun binary, {home} = OMOCAT_HOME, {logs} = ~/Library/Logs/dandori-kakao. Label = <launchd.prefix>.<name> from config.json. launchd.services in config.json picks which ones are installed.",
  "supervisor": { "args": ["{bun}", "dori-supervisor.ts"], "keepAlive": true, "throttle": 5, "out": "~/Library/Logs/dandori-supervisor/supervisor.log" },
  "kakao-live": { "args": ["{bun}", "kakao-loco.ts"], "keepAlive": true, "out": "{logs}/live.ndjson", "err": "{logs}/live.err.log" },
  "kakao-push": { "args": ["{bun}", "kakao-push.ts"], "keepAlive": true, "throttle": 10, "out": "{logs}/push.log" },
  "kakao-health": { "args": ["/bin/bash", "kakao-health.sh"], "interval": 60, "out": "{logs}/health.log" },
  "heartbeat": { "args": ["{bun}", "heartbeat.ts", "run"], "interval": 300, "env": { "HEARTBEAT_LANE_RESTART": "0", "HEARTBEAT_RESTART_KAKAO": "0" }, "out": "{logs}/heartbeat.log" },
  "decisions": { "args": ["{bun}", "decision.ts", "tick"], "interval": 300, "out": "{logs}/decisions.log" },
  "ceo-weekly": { "args": ["{bun}", "ceo-weekly.ts"], "calendar": { "Weekday": 1, "Hour": 8, "Minute": 30 }, "out": "{logs}/ceo-weekly.log" },
  "repo-patrol": { "args": ["{bun}", "repo-patrol.ts", "run"], "calendar": { "Hour": 9, "Minute": 30 }, "out": "{logs}/repo-patrol.log" },
  "wake-filter-stats": { "args": ["{bun}", "wake-filter-stats.ts"], "calendar": { "Hour": 9, "Minute": 0 }, "out": "{logs}/wake-filter-stats.log" },
  "git-sync": { "args": ["/bin/bash", "git-sync.sh"], "interval": 3600, "out": "{logs}/git-sync.log" }
}
